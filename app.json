{
  "expo": {
    "name": "Your Cycle",
    "slug": "your-cycle",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "yourcycle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-v2.png",
      "bundleIdentifier": "app.yourcycle.mobile",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your private cycle records.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.yourcycle.mobile",
      "versionCode": 4,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F0",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-local-data-hardening.js",
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Use Face ID to unlock your private cycle records."
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#174A32"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F0",
          "image": "./assets/images/splash-icon-v2.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0F1511",
            "image": "./assets/images/splash-icon-v2.png"
          }
        }
      ]
    ],
    "extra": {
      "privacyMode": "offline-only"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
